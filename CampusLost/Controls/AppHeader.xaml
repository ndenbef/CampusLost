<?xml version="1.0" encoding="utf-8" ?>
<ContentView x:Class="CampusLost.Controls.AppHeader"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Name="Root">
    <Grid RowDefinitions="60,1" BackgroundColor="White">
        <Grid ColumnDefinitions="60,*,60">
            <Label Text="←" FontSize="26" HorizontalTextAlignment="Center" VerticalTextAlignment="Center"
                   IsVisible="{Binding ShowBack, Source={x:Reference Root}}">
                <Label.GestureRecognizers><TapGestureRecognizer Tapped="OnBack"/></Label.GestureRecognizers>
            </Label>
            <Label Grid.Column="1" Text="{Binding Title, Source={x:Reference Root}}" Style="{StaticResource Bold}"
                   FontSize="20" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" LineBreakMode="TailTruncation"/>
            <Label Grid.Column="2" Text="•••" FontSize="18" TextColor="{StaticResource Muted}"
                   HorizontalTextAlignment="Center" VerticalTextAlignment="Center"
                   IsVisible="{Binding ShowMenu, Source={x:Reference Root}}">
                <Label.GestureRecognizers><TapGestureRecognizer Tapped="OnMenu"/></Label.GestureRecognizers>
            </Label>
        </Grid>
        <BoxView Grid.Row="1" Color="{StaticResource Line}"/>
    </Grid>
</ContentView>
