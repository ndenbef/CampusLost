<?xml version="1.0" encoding="utf-8" ?>
<ContentView x:Class="CampusLost.Controls.ItemCard"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:c="clr-namespace:CampusLost.Controls">
    <Border Style="{StaticResource Card}">
        <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnCardTapped"/></Border.GestureRecognizers>
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
            <c:Thumb Size="84"/>
            <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                <Label Text="{Binding Name}" Style="{StaticResource Bold}" FontSize="18" LineBreakMode="TailTruncation"/>
                <Border Style="{StaticResource Pill}" BackgroundColor="{Binding PillBg}">
                    <Label Text="{Binding StatusText}" TextColor="{Binding PillFg}" FontFamily="OpenSansSemibold" FontSize="13"/>
                </Border>
                <Label Text="{Binding Where}" Style="{StaticResource Small}" LineBreakMode="TailTruncation"/>
                <Label Text="{Binding DateShort}" Style="{StaticResource Small}"/>
            </VerticalStackLayout>
            <Label Grid.Column="2" Text="{Binding HeartGlyph}" TextColor="{Binding HeartColor}" FontSize="26"
                   VerticalOptions="Start" Padding="6">
                <Label.GestureRecognizers><TapGestureRecognizer Tapped="OnHeartTapped"/></Label.GestureRecognizers>
            </Label>
        </Grid>
    </Border>
</ContentView>
