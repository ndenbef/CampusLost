<?xml version="1.0" encoding="utf-8" ?>
<ContentView x:Class="CampusLost.Controls.CampusBanner"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             HeightRequest="150">
    <!-- Illustration de remplacement : mettez une vraie image ici (Image Aspect="AspectFill"). -->
    <Border Stroke="Transparent" StrokeShape="RoundRectangle 18">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#A8E4F8" Offset="0.0"/>
                <GradientStop Color="#CDEFD9" Offset="0.55"/>
                <GradientStop Color="#6CC48B" Offset="1.0"/>
            </LinearGradientBrush>
        </Border.Background>
        <Grid RowDefinitions="*,Auto" Padding="0,0,0,10">
            <Label Text="🏫" FontSize="64" HorizontalOptions="Center" VerticalOptions="End"/>
            <Label Grid.Row="1" Text="🌳  🚲  🧑‍🎓  🌳  🧑‍🎓  🌳" FontSize="22" HorizontalOptions="Center"/>
        </Grid>
    </Border>
</ContentView>
