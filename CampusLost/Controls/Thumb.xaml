<?xml version="1.0" encoding="utf-8" ?>
<ContentView x:Class="CampusLost.Controls.Thumb"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
    <Border BackgroundColor="#E9EEF2" Stroke="Transparent" StrokeShape="RoundRectangle 12">
        <Grid>
            <Image Source="{Binding PhotoPath}" Aspect="AspectFill" IsVisible="{Binding HasPhoto}"/>
            <Label x:Name="Emo" Text="{Binding Emoji}" IsVisible="{Binding NoPhoto}"
                   HorizontalOptions="Center" VerticalOptions="Center"/>
        </Grid>
    </Border>
</ContentView>
