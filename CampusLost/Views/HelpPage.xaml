<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="CampusLost.Views.HelpPage" xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:c="clr-namespace:CampusLost.Controls" BackgroundColor="{StaticResource Bg}" Shell.TabBarIsVisible="True" Title="Aide &amp; FAQ">
    <Grid RowDefinitions="Auto,*">
        <c:AppHeader Title="Aide &amp; FAQ"/>
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="18,16" Spacing="14">
                <Label Text="Comment peut-on vous aider ?" Style="{StaticResource H1}"/>
                <Label Text="Les réponses à vos questions sur CampusLost." Style="{StaticResource Sub}"/>

                <Label Text="Rechercher dans l'aide" Style="{StaticResource Bold}" Margin="0,6,0,0"/>
                <Border Style="{StaticResource Field}">
                    <Grid ColumnDefinitions="*,Auto">
                        <Entry Text="{Binding Search}" Placeholder="Votre question…" Style="{StaticResource Input}"/>
                        <Label Grid.Column="1" Text="🔍" FontSize="18" VerticalOptions="Center"/>
                    </Grid>
                </Border>

                <Border Style="{StaticResource Card}" Padding="0">
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Entries}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <VerticalStackLayout>
                                    <BoxView HeightRequest="1" Color="{StaticResource Line}"/>
                                    <VerticalStackLayout Padding="16,14" Spacing="8">
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                            <Label Text="❓" FontSize="20" VerticalOptions="Center"/>
                                            <Label Grid.Column="1" Text="{Binding Question}" Style="{StaticResource Bold}" VerticalOptions="Center"/>
                                            <Label Grid.Column="2" Text="{Binding Chevron}" FontSize="24" TextColor="{StaticResource Muted}" VerticalOptions="Center"/>
                                            <Grid.GestureRecognizers><TapGestureRecognizer Tapped="OnEntryTapped"/></Grid.GestureRecognizers>
                                        </Grid>
                                        <Label Text="{Binding Answer}" IsVisible="{Binding IsOpen}" Style="{StaticResource Sub}" FontSize="14" Margin="32,0,0,0"/>
                                    </VerticalStackLayout>
                                </VerticalStackLayout>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource Soft}" Padding="18">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Vous avez encore une question ?" Style="{StaticResource Bold}" FontSize="18"/>
                        <Label Text="Notre équipe vous répond du lundi au vendredi, sous 48 h." TextColor="{StaticResource GreenDark}" FontSize="14"/>
                        <Button Text="✉  Contacter l'assistance" Style="{StaticResource Primary}" Command="{Binding ContactSupportCommand}" Margin="0,6,0,0"/>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
