<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="CampusLost.Views.ReportPage" xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:c="clr-namespace:CampusLost.Controls" BackgroundColor="{StaticResource Bg}" Shell.TabBarIsVisible="True" Title="Signaler">
    <Grid RowDefinitions="Auto,*">
        <c:AppHeader Title="{Binding Title}"/>
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="18,16" Spacing="6">

                <c:StepperView Step="{Binding Step}" Margin="0,0,0,14"/>

                <!-- ÉTAPE 1 : Infos objet -->
                <VerticalStackLayout IsVisible="{Binding IsStep1}" Spacing="4">
                    <Label Text="Quel est cet objet ?" Style="{StaticResource H1}"/>
                    <Label Text="Décrivez l'objet pour faciliter son identification." Style="{StaticResource Sub}"/>

                    <Label Text="Nom de l'objet *" Style="{StaticResource FieldLabel}"/>
                    <Border Style="{StaticResource Field}"><Entry Text="{Binding Name}" Placeholder="Ex. : Sac à dos noir" Style="{StaticResource Input}"/></Border>

                    <Label Text="Catégorie *" Style="{StaticResource FieldLabel}"/>
                    <Border Style="{StaticResource Field}">
                        <Grid ColumnDefinitions="*,Auto">
                            <Picker Title="Choisir une catégorie" ItemsSource="{Binding Categories}" SelectedItem="{Binding Category}" Style="{StaticResource PickerInput}"/>
                            <Label Grid.Column="1" Text="⌄" FontSize="20" TextColor="{StaticResource Muted}" VerticalOptions="Center"/>
                        </Grid>
                    </Border>

                    <Label Text="Description *" Style="{StaticResource FieldLabel}"/>
                    <Border Style="{StaticResource Field}" HeightRequest="-1" Padding="10,6">
                        <Editor Text="{Binding Description}" Placeholder="Couleur, marque, contenu…" Style="{StaticResource InputMulti}"/>
                    </Border>

                    <Border Style="{StaticResource Info}" Margin="0,14,0,0">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <Label Text="ⓘ" FontSize="20" TextColor="{StaticResource Blue}" VerticalOptions="Start"/>
                            <Label Grid.Column="1" Text="Ne partagez pas de données personnelles. Gardez un détail pour vérifier l'identité du propriétaire."
                                   Style="{StaticResource Sub}" FontSize="14"/>
                        </Grid>
                    </Border>
                </VerticalStackLayout>

                <!-- ÉTAPE 2 : Où et quand -->
                <VerticalStackLayout IsVisible="{Binding IsStep2}" Spacing="4">
                    <Label Text="Où et quand ?" Style="{StaticResource H1}"/>
                    <Label Text="Précisez le lieu et la date sur le campus." Style="{StaticResource Sub}"/>

                    <Label Text="{Binding PlaceLabel}" Style="{StaticResource FieldLabel}"/>
                    <Border Style="{StaticResource Field}">
                        <Grid ColumnDefinitions="*,Auto">
                            <Entry Text="{Binding Place}" Placeholder="Ex. : Bâtiment B" Style="{StaticResource Input}"/>
                            <Label Grid.Column="1" Text="📍" FontSize="18" VerticalOptions="Center"/>
                        </Grid>
                    </Border>

                    <Label Text="Précisions sur le lieu" Style="{StaticResource FieldLabel}"/>
                    <Border Style="{StaticResource Field}"><Entry Text="{Binding PlaceDetail}" Placeholder="Ex. : Amphi 3, près du dernier rang" Style="{StaticResource Input}"/></Border>

                    <Grid ColumnDefinitions="*,140" ColumnSpacing="12">
                        <VerticalStackLayout>
                            <Label Text="{Binding DateLabel}" Style="{StaticResource FieldLabel}"/>
                            <Border Style="{StaticResource Field}">
                                <Grid ColumnDefinitions="*,Auto">
                                    <DatePicker Date="{Binding Date}" Format="dd / MM / yyyy" TextColor="{StaticResource Ink}" FontFamily="OpenSansRegular" BackgroundColor="Transparent" VerticalOptions="Center"/>
                                    <Label Grid.Column="1" Text="📅" FontSize="18" VerticalOptions="Center" InputTransparent="True"/>
                                </Grid>
                            </Border>
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1">
                            <Label Text="Heure estimée" Style="{StaticResource FieldLabel}"/>
                            <Border Style="{StaticResource Field}">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TimePicker Time="{Binding Time}" Format="HH:mm" TextColor="{StaticResource Ink}" FontFamily="OpenSansRegular" BackgroundColor="Transparent" VerticalOptions="Center"/>
                                    <Label Grid.Column="1" Text="🕒" FontSize="18" VerticalOptions="Center" InputTransparent="True"/>
                                </Grid>
                            </Border>
                        </VerticalStackLayout>
                    </Grid>

                    <VerticalStackLayout IsVisible="{Binding IsFound}" Spacing="4">
                        <Label Text="Où se trouve l'objet maintenant ?" Style="{StaticResource FieldLabel}"/>
                        <Border Style="{StaticResource Field}">
                            <Grid ColumnDefinitions="*,Auto">
                                <Entry Text="{Binding CurrentLocation}" Placeholder="Ex. : À l'accueil de la bibliothèque" Style="{StaticResource Input}"/>
                                <Label Grid.Column="1" Text="🏢" FontSize="18" VerticalOptions="Center"/>
                            </Grid>
                        </Border>
                    </VerticalStackLayout>

                    <Border Style="{StaticResource Info}" Margin="0,14,0,0">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <Label Text="ⓘ" FontSize="20" TextColor="{StaticResource Blue}" VerticalOptions="Start"/>
                            <Label Grid.Column="1" Text="{Binding Step2Hint}" Style="{StaticResource Sub}" FontSize="14"/>
                        </Grid>
                    </Border>
                </VerticalStackLayout>

                <!-- ÉTAPE 3 : Photo -->
                <VerticalStackLayout IsVisible="{Binding IsStep3}" Spacing="12">
                    <Label Text="Ajoutez une photo" Style="{StaticResource H1}"/>
                    <Label Text="Une photo aide à reconnaître l'objet plus vite." Style="{StaticResource Sub}"/>

                    <Border Style="{StaticResource Card}" Padding="14">
                        <VerticalStackLayout Spacing="12">
                            <Border HeightRequest="230" BackgroundColor="#E9EEF2" Stroke="Transparent" StrokeShape="RoundRectangle 12">
                                <Grid>
                                    <Image Source="{Binding PhotoPath}" Aspect="AspectFill" IsVisible="{Binding HasPhoto}"/>
                                    <VerticalStackLayout IsVisible="{Binding NoPhoto}" VerticalOptions="Center" Spacing="4">
                                        <Label Text="📷" FontSize="48" HorizontalOptions="Center"/>
                                        <Label Text="Aucune photo" Style="{StaticResource Sub}" HorizontalOptions="Center"/>
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>
                            <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding HasPhoto}">
                                <Label Text="{Binding PhotoInfo}" Style="{StaticResource Small}" VerticalOptions="Center"/>
                                <Label Grid.Column="1" Text="🗑" FontSize="22" TextColor="{StaticResource Red}">
                                    <Label.GestureRecognizers><TapGestureRecognizer Command="{Binding RemovePhotoCommand}"/></Label.GestureRecognizers>
                                </Label>
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <Button Text="📷  Prendre une photo" Style="{StaticResource Secondary}" FontSize="15" Command="{Binding TakePhotoCommand}"/>
                        <Button Grid.Column="1" Text="🖼  Galerie" Style="{StaticResource Secondary}" FontSize="15" Command="{Binding PickPhotoCommand}"/>
                    </Grid>

                    <Border Style="{StaticResource Info}">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <Label Text="ⓘ" FontSize="20" TextColor="{StaticResource Blue}" VerticalOptions="Start"/>
                            <Label Grid.Column="1" Text="JPG ou PNG, 5 Mo maximum. La photo est facultative ; évitez les visages et les informations privées."
                                   Style="{StaticResource Sub}" FontSize="14"/>
                        </Grid>
                    </Border>
                </VerticalStackLayout>

                <!-- ÉTAPE 4 : Confirmation -->
                <VerticalStackLayout IsVisible="{Binding IsStep4}" Spacing="12">
                    <Label Text="Vérifiez votre signalement" Style="{StaticResource H1}"/>
                    <Label Text="Tout est prêt ? Publiez votre annonce." Style="{StaticResource Sub}"/>

                    <Border Style="{StaticResource Card}" Padding="14">
                        <VerticalStackLayout Spacing="14">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                                <Border WidthRequest="110" HeightRequest="110" BackgroundColor="#E9EEF2" Stroke="Transparent" StrokeShape="RoundRectangle 12" VerticalOptions="Start">
                                    <Grid>
                                        <Image Source="{Binding PhotoPath}" Aspect="AspectFill" IsVisible="{Binding HasPhoto}"/>
                                        <Label Text="{Binding ConfirmEmoji}" FontSize="48" IsVisible="{Binding NoPhoto}" HorizontalOptions="Center" VerticalOptions="Center"/>
                                    </Grid>
                                </Border>
                                <VerticalStackLayout Grid.Column="1" Spacing="6" VerticalOptions="Center">
                                    <Border Style="{StaticResource Pill}" BackgroundColor="{Binding PillBg}">
                                        <Label Text="{Binding StatusLabel}" TextColor="{Binding PillFg}" FontFamily="OpenSansSemibold" FontSize="13"/>
                                    </Border>
                                    <Label Text="{Binding Name}" Style="{StaticResource H2}" FontSize="22"/>
                                    <Label Text="{Binding Category}" Style="{StaticResource Sub}"/>
                                </VerticalStackLayout>
                            </Grid>
                            <Grid ColumnDefinitions="32,*"><Label Text="📍" FontSize="20"/><Label Grid.Column="1" Text="{Binding ConfirmWhere}" Style="{StaticResource Bold}"/></Grid>
                            <Grid ColumnDefinitions="32,*"><Label Text="📅" FontSize="20"/><Label Grid.Column="1" Text="{Binding ConfirmWhen}" Style="{StaticResource Bold}"/></Grid>
                            <Label Text="{Binding Description}" Style="{StaticResource Sub}" FontSize="14"/>
                        </VerticalStackLayout>
                    </Border>

                    <HorizontalStackLayout Spacing="8">
                        <CheckBox IsChecked="{Binding Consent}" Color="{StaticResource Green}" VerticalOptions="Start"/>
                        <Label Text="J'accepte que les membres du campus me contactent au sujet de cet objet." Style="{StaticResource Bold}" FontSize="15" WidthRequest="300" VerticalOptions="Center"/>
                    </HorizontalStackLayout>

                    <Border Style="{StaticResource Info}">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <Label Text="🛡" FontSize="20" VerticalOptions="Start"/>
                            <Label Grid.Column="1" Text="Votre adresse e-mail reste privée. Vous pourrez modifier ou supprimer l'annonce depuis Mes annonces."
                                   Style="{StaticResource Sub}" FontSize="14"/>
                        </Grid>
                    </Border>
                </VerticalStackLayout>

                <!-- Actions -->
                <Label Text="{Binding Error}" IsVisible="{Binding HasError}" Style="{StaticResource ErrorText}" Margin="0,10,0,0"/>
                <Button Text="→  Suivant" Style="{StaticResource Primary}" Margin="0,14,0,0" IsVisible="{Binding IsNotLast}" Command="{Binding NextCommand}"/>
                <Button Text="{Binding PublishText}" Style="{StaticResource Primary}" Margin="0,14,0,0" IsVisible="{Binding IsStep4}" Command="{Binding PublishCommand}"/>
                <Button Text="Précédent" Style="{StaticResource Secondary}" Margin="0,6,0,0" IsVisible="{Binding CanGoBack}" Command="{Binding PreviousCommand}"/>
                <Label Text="{Binding FooterText}" Style="{StaticResource Small}" HorizontalTextAlignment="Center" Margin="0,8,0,8"/>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
