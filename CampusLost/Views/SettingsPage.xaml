<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="CampusLost.Views.SettingsPage" xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:c="clr-namespace:CampusLost.Controls" BackgroundColor="{StaticResource Bg}" Shell.TabBarIsVisible="True" Title="Paramètres">
    <Grid RowDefinitions="Auto,*">
        <c:AppHeader Title="Paramètres"/>
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="18,16" Spacing="12">

                <Label Text="Notifications" Style="{StaticResource H2}" FontSize="19"/>
                <Border Style="{StaticResource Card}" Padding="16">
                    <VerticalStackLayout Spacing="16">
                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout><Label Text="Messages reçus" Style="{StaticResource Bold}" FontSize="17"/><Label Text="Quand un membre vous contacte." Style="{StaticResource Small}"/></VerticalStackLayout>
                            <Switch Grid.Column="1" IsToggled="{Binding MessagesNotif}" OnColor="{StaticResource Green}"/>
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout><Label Text="Annonces similaires" Style="{StaticResource Bold}" FontSize="17"/><Label Text="Des objets qui peuvent vous correspondre." Style="{StaticResource Small}"/></VerticalStackLayout>
                            <Switch Grid.Column="1" IsToggled="{Binding SimilarNotif}" OnColor="{StaticResource Green}"/>
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout><Label Text="Actualités du campus" Style="{StaticResource Bold}" FontSize="17"/><Label Text="Conseils et nouveautés CampusLost." Style="{StaticResource Small}"/></VerticalStackLayout>
                            <Switch Grid.Column="1" IsToggled="{Binding NewsNotif}" OnColor="{StaticResource Green}"/>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <Label Text="Mon compte" Style="{StaticResource H2}" FontSize="19" Margin="0,8,0,0"/>
                <Border Style="{StaticResource Card}" Padding="0">
                    <VerticalStackLayout>
                        <Grid ColumnDefinitions="44,*,Auto" Padding="18,16">
                            <Label Text="🔒" FontSize="22" VerticalOptions="Center"/>
                            <Label Grid.Column="1" Text="Changer mon mot de passe" Style="{StaticResource Bold}" FontSize="17" VerticalOptions="Center"/>
                            <Label Grid.Column="2" Text="›" FontSize="26" TextColor="{StaticResource Muted}" VerticalOptions="Center"/>
                            <Grid.GestureRecognizers><TapGestureRecognizer Command="{Binding ChangePasswordCommand}"/></Grid.GestureRecognizers>
                        </Grid>
                        <Grid ColumnDefinitions="44,*,Auto" Padding="18,16">
                            <Label Text="📍" FontSize="22" VerticalOptions="Center"/>
                            <VerticalStackLayout Grid.Column="1"><Label Text="Mon campus" Style="{StaticResource Bold}" FontSize="17"/><Label Text="{Binding Campus}" Style="{StaticResource Small}"/></VerticalStackLayout>
                            <Label Grid.Column="2" Text="›" FontSize="26" TextColor="{StaticResource Muted}" VerticalOptions="Center"/>
                            <Grid.GestureRecognizers><TapGestureRecognizer Command="{Binding ChooseCampusCommand}"/></Grid.GestureRecognizers>
                        </Grid>
                        <Grid ColumnDefinitions="44,*,Auto" Padding="18,16">
                            <Label Text="🌐" FontSize="22" VerticalOptions="Center"/>
                            <VerticalStackLayout Grid.Column="1"><Label Text="Langue de l'application" Style="{StaticResource Bold}" FontSize="17"/><Label Text="Français" Style="{StaticResource Small}"/></VerticalStackLayout>
                            <Label Grid.Column="2" Text="›" FontSize="26" TextColor="{StaticResource Muted}" VerticalOptions="Center"/>
                            <Grid.GestureRecognizers><TapGestureRecognizer Command="{Binding ChooseLanguageCommand}"/></Grid.GestureRecognizers>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <Label Text="Confidentialité" Style="{StaticResource H2}" FontSize="19" Margin="0,8,0,0"/>
                <Border Style="{StaticResource Card}" Padding="0">
                    <VerticalStackLayout>
                        <Grid ColumnDefinitions="44,*,Auto" Padding="18,16">
                            <Label Text="🛡" FontSize="22" VerticalOptions="Center"/>
                            <Label Grid.Column="1" Text="Données personnelles" Style="{StaticResource Bold}" FontSize="17" VerticalOptions="Center"/>
                            <Label Grid.Column="2" Text="›" FontSize="26" TextColor="{StaticResource Muted}" VerticalOptions="Center"/>
                            <Grid.GestureRecognizers><TapGestureRecognizer Command="{Binding PrivacyCommand}"/></Grid.GestureRecognizers>
                        </Grid>
                        <Grid ColumnDefinitions="44,*,Auto" Padding="18,16">
                            <Label Text="📄" FontSize="22" VerticalOptions="Center"/>
                            <Label Grid.Column="1" Text="Conditions d'utilisation" Style="{StaticResource Bold}" FontSize="17" VerticalOptions="Center"/>
                            <Label Grid.Column="2" Text="›" FontSize="26" TextColor="{StaticResource Muted}" VerticalOptions="Center"/>
                            <Grid.GestureRecognizers><TapGestureRecognizer Command="{Binding TermsCommand}"/></Grid.GestureRecognizers>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <Label Text="🗑  Supprimer mon compte" TextColor="{StaticResource Red}" FontFamily="OpenSansSemibold" FontSize="16"
                       HorizontalOptions="Center" Margin="0,10,0,10">
                    <Label.GestureRecognizers><TapGestureRecognizer Command="{Binding DeleteAccountCommand}"/></Label.GestureRecognizers>
                </Label>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
