<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="CampusLost.Views.ContactPage" xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:c="clr-namespace:CampusLost.Controls" BackgroundColor="{StaticResource Bg}" Shell.TabBarIsVisible="True" Title="Contacter l'annonceur">
    <Grid RowDefinitions="Auto,*">
        <c:AppHeader Title="Contacter l'annonceur"/>
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="18,16" Spacing="8">
                <c:ItemCard BindingContext="{Binding Ad}"/>

                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14" Margin="0,12,0,4">
                    <Border WidthRequest="56" HeightRequest="56" BackgroundColor="{StaticResource GreenSoft}" Stroke="Transparent" StrokeShape="RoundRectangle 28">
                        <Label Text="{Binding Ad.OwnerInitials}" TextColor="{StaticResource GreenDark}" FontFamily="OpenSansSemibold" FontSize="20"
                               HorizontalOptions="Center" VerticalOptions="Center"/>
                    </Border>
                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                        <Label Text="Votre message à" Style="{StaticResource Small}"/>
                        <Label Text="{Binding Ad.OwnerName}" Style="{StaticResource H2}" FontSize="20"/>
                    </VerticalStackLayout>
                </Grid>

                <Label Text="Objet du message" Style="{StaticResource FieldLabel}"/>
                <Border Style="{StaticResource Field}"><Entry Text="{Binding Subject}" Style="{StaticResource Input}"/></Border>

                <Label Text="Votre message *" Style="{StaticResource FieldLabel}"/>
                <Border Style="{StaticResource Field}" HeightRequest="-1" Padding="10,6">
                    <Editor Text="{Binding Message}" Style="{StaticResource InputMulti}" AutoSize="TextChanges" MinimumHeightRequest="130"/>
                </Border>
                <Label Text="{Binding SenderLine}" Style="{StaticResource Small}"/>

                <Border Style="{StaticResource Info}" Margin="0,8,0,8">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <Label Text="🛡" FontSize="20" VerticalOptions="Start"/>
                        <Label Grid.Column="1" Text="Décrivez un détail distinctif pour confirmer que l'objet vous appartient. Ne transmettez jamais de mot de passe ni de paiement."
                               Style="{StaticResource Sub}" FontSize="14"/>
                    </Grid>
                </Border>

                <Label Text="{Binding Error}" IsVisible="{Binding HasError}" Style="{StaticResource ErrorText}"/>
                <Button Text="➤  Envoyer le message" Style="{StaticResource Primary}" Command="{Binding SendCommand}"/>
                <Label Text="{Binding ReplyLine}" Style="{StaticResource Small}" HorizontalTextAlignment="Center" Margin="0,8,0,8"/>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
